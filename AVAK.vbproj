<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <MyType>WindowsFormsWithCustomSubMain</MyType>
    <StartupObject>AVAK.Program</StartupObject>
    <RootNamespace>AVAK</RootNamespace>
    <AssemblyName>AVAK</AssemblyName>

    <OptionExplicit>On</OptionExplicit>
    <OptionStrict>On</OptionStrict>
    <OptionInfer>On</OptionInfer>
    <OptionCompare>Binary</OptionCompare>
    <LangVersion>latest</LangVersion>

    <Product>AVAK Antivirus</Product>
    <Company>AVAK</Company>
    <Version>3.0.0</Version>
    <Copyright>Copyright (c) 2026 AVAK</Copyright>
    <Description>AVAK - an extensible Windows security toolkit. Detection is plugin- and data-driven.</Description>

    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets/avak.ico</ApplicationIcon>
    <Platforms>AnyCPU;x64</Platforms>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1416</NoWarn>

    <!-- The legacy WinForms-Designer sources (CLASS/, CONTROL/, FORMS/, My Project/)
         are intentionally NOT compiled. Everything new lives under src/. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\**\*.vb" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Everything under content\ is data the user can edit without rebuilding. -->
    <None Include="content\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>content\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
    <None Include="plugins\README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>plugins\README.md</Link>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Import Include="Microsoft.VisualBasic" />
    <Import Include="System" />
    <Import Include="System.Collections.Generic" />
    <Import Include="System.Diagnostics" />
    <Import Include="System.Drawing" />
    <Import Include="System.Linq" />
    <Import Include="System.Threading.Tasks" />
    <Import Include="System.Windows.Forms" />
  </ItemGroup>

</Project>
