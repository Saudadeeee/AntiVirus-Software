{
  "name": "AVAK default heuristics",
  "version": "1",
  "description": "Weights and markers used by the heuristic provider. Edit any number here and restart AVAK - no rebuild needed. Copy this file to %LOCALAPPDATA%\\AVAK\\heuristics.json to override it without touching the installation.",

  "thresholds": {
    "low": 18,
    "medium": 32,
    "high": 50,
    "critical": 70
